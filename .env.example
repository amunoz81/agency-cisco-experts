# ============================================================================
# Cisco Experts Agency - configuración de entorno
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env`.
# ============================================================================

# Proveedor de LLM: anthropic | openai | azure
LLM_PROVIDER=anthropic

# Modo offline: "true" ejecuta la agencia con respuestas plantilladas
# deterministas (sin llamar a ningún LLM). Útil para demos y CI.
OFFLINE=false

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI (API pública) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Parámetros de generación
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Contexto comercial que se consulta por oportunidad (no hardcodear en código)
FISCAL_YEAR=FY26
CURRENCY=USD
