# ============================================================================
# Cisco Experts Agency - configuración de entorno
# Copia este archivo a `.env` y completa los valores. NUNCA subas `.env`.
# ============================================================================

# Proveedor de LLM GLOBAL por defecto: anthropic | openai | azure
# (cada agente puede sobreescribirlo en config/models.yaml)
LLM_PROVIDER=anthropic

# Ruta opcional al YAML de enrutamiento de modelos por rol.
# Si se omite, se usa ./config/models.yaml. Ver `cisco-agency models`.
# MODELS_CONFIG=config/models.yaml

# La agencia sincroniza el corpus de CVDs con el catálogo en cada arranque.
# Ponlo en false para desactivar la auto-sincronización (p. ej. instalación
# de solo lectura o para fijar el corpus manualmente).
AUTO_INGEST_CVD=true

# Modo offline: "true" ejecuta la agencia con respuestas plantilladas
# deterministas (sin llamar a ningún LLM). Útil para demos y CI.
OFFLINE=false

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI (API pública) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Parámetros de generación
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# Contexto comercial que se consulta por oportunidad (no hardcodear en código)
FISCAL_YEAR=FY26
CURRENCY=USD

# --- Trazas / observabilidad (LangSmith, opcional) ---
# Con estas variables, LangChain/LangGraph envían trazas por nodo, tokens y
# latencia a LangSmith. Sin ellas, la agencia igual genera su run_report JSON.
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=
# LANGCHAIN_PROJECT=cisco-experts-agency
